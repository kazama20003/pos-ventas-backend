  @@unique([inquilinoId, idempotencyKey])
  @@unique([inquilinoId, id])
  @@index([inquilinoId, proveedorId, pagadoEn])
}

model AccountsReceivable {
  id             String                     @id @default(uuid()) @db.Uuid
  inquilinoId    String                     @db.Uuid
  clienteId      String                     @db.Uuid
  ventaId        String                     @unique @db.Uuid
  moneda         String                     @db.Char(3)
  montoOriginal  Decimal                    @db.Decimal(18, 2)
  /// Transactional projection only; payment allocations are authoritative.
  montoPendiente Decimal                    @db.Decimal(18, 2)
  estado         EstadoCuentaPorCobrarPagar @default(PENDIENTE)
  emitidoEn      DateTime
  venceEn        DateTime
  creadoEn       DateTime                   @default(now())
  actualizadoEn  DateTime                   @updatedAt
  sale           Sale                       @relation(fields: [inquilinoId, clienteId, ventaId], references: [inquilinoId, clienteId, id], onDelete: Restrict)
  customer       Customer                   @relation(fields: [inquilinoId, clienteId], references: [inquilinoId, id], onDelete: Restrict)
  cuotas         ReceivableInstallment[]

  @@unique([inquilinoId, id])
  @@unique([inquilinoId, clienteId, ventaId])
  @@index([inquilinoId, clienteId, estado, venceEn])
}

model ReceivableInstallment {
  id             String                        @id @default(uuid()) @db.Uuid
  inquilinoId    String                        @db.Uuid
  receivableId   String                        @db.Uuid
  installmentNo  Int
  venceEn        DateTime
  monto          Decimal                       @db.Decimal(18, 2)
  montoPendiente Decimal                       @db.Decimal(18, 2)
  estado         EstadoCuentaPorCobrarPagar    @default(PENDIENTE)
  receivable     AccountsReceivable            @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  allocations    ReceivablePaymentAllocation[]

  @@unique([inquilinoId, receivableId, installmentNo])
  @@unique([inquilinoId, id])
  @@index([inquilinoId, estado, venceEn])
}

model ReceivablePayment {
  id             String                        @id @default(uuid()) @db.Uuid
  inquilinoId    String                        @db.Uuid
  clienteId      String                        @db.Uuid
  idempotencyKey String
  method         MetodoPago
  monto          Decimal                       @db.Decimal(18, 2)
  moneda         String                        @db.Char(3)
  referencia     String?
  pagadoEn       DateTime                      @default(now())
  createdById    String                        @db.Uuid
  allocations    ReceivablePaymentAllocation[]
  customer       Customer                      @relation(fields: [inquilinoId, clienteId], references: [inquilinoId, id], onDelete: Restrict)

  @@unique([inquilinoId, idempotencyKey])
  @@unique([inquilinoId, id])
  @@index([inquilinoId, clienteId, pagadoEn])
}

model ReceivablePaymentAllocation {
  /// Authoritative application of receivable cash; open balances are projections updated in same transaction.
  id            String                @id @default(uuid()) @db.Uuid
  inquilinoId   String                @db.Uuid
  paymentId     String                @db.Uuid
  installmentId String                @db.Uuid
  monto         Decimal               @db.Decimal(18, 2)
  payment       ReceivablePayment     @relation(fields: [inquilinoId, paymentId], references: [inquilinoId, id], onDelete: Restrict)
  installment   ReceivableInstallment @relation(fields: [inquilinoId, installmentId], references: [inquilinoId, id], onDelete: Restrict)

  @@unique([inquilinoId, paymentId, installmentId])
  @@index([inquilinoId, installmentId])
}

model AccountsPayable {
  id                String                     @id @default(uuid()) @db.Uuid
  inquilinoId       String                     @db.Uuid
  proveedorId       String                     @db.Uuid
  recepcionCompraId String                     @unique @db.Uuid
  moneda            String                     @db.Char(3)
  montoOriginal     Decimal                    @db.Decimal(18, 2)
  /// Transactional projection only; payment allocations are authoritative.
  montoPendiente    Decimal                    @db.Decimal(18, 2)
  estado            EstadoCuentaPorCobrarPagar @default(PENDIENTE)
  emitidoEn         DateTime
  venceEn           DateTime
  creadoEn          DateTime                   @default(now())
  actualizadoEn     DateTime                   @updatedAt
  purchaseReceipt   PurchaseReceipt            @relation(fields: [inquilinoId, proveedorId, recepcionCompraId], references: [inquilinoId, proveedorId, id], onDelete: Restrict)
  supplier          Supplier                   @relation(fields: [inquilinoId, proveedorId], references: [inquilinoId, id], onDelete: Restrict)
  cuotas            PayableInstallment[]

  @@unique([inquilinoId, id])
  @@unique([inquilinoId, proveedorId, recepcionCompraId])
  @@index([inquilinoId, proveedorId, estado, venceEn])
}

model PayableInstallment {
  id             String                     @id @default(uuid()) @db.Uuid
  inquilinoId    String                     @db.Uuid
  payableId      String                     @db.Uuid
  installmentNo  Int
  venceEn        DateTime
  monto          Decimal                    @db.Decimal(18, 2)
  montoPendiente Decimal                    @db.Decimal(18, 2)
  estado         EstadoCuentaPorCobrarPagar @default(PENDIENTE)
  payable        AccountsPayable            @relation(fields: [payableId], references: [id], onDelete: Restrict)
  allocations    PayablePaymentAllocation[]

  @@unique([inquilinoId, payableId, installmentNo])
  @@unique([inquilinoId, id])
  @@index([inquilinoId, estado, venceEn])
}

model PayablePaymentAllocation {
  /// Authoritative application of supplier cash; open balances are projections updated in same transaction.
  id            String             @id @default(uuid()) @db.Uuid
  inquilinoId   String             @db.Uuid
  paymentId     String             @db.Uuid
  installmentId String             @db.Uuid
  monto         Decimal            @db.Decimal(18, 2)
  payment       PurchasePayment    @relation(fields: [inquilinoId, paymentId], references: [inquilinoId, id], onDelete: Restrict)
  installment   PayableInstallment @relation(fields: [inquilinoId, installmentId], references: [inquilinoId, id], onDelete: Restrict)

  @@unique([inquilinoId, paymentId, installmentId])
  @@index([inquilinoId, installmentId])
}

model AuditLog {
  id                   String   @id @default(uuid()) @db.Uuid
  inquilinoId          String   @db.Uuid
  actorIdentityId      String?  @db.Uuid
  actorMembershipId    String?  @db.Uuid
  approverMembershipId String?  @db.Uuid
  deviceId             String?
  ipAddress            String?  @db.Inet
  userAgent            String?
  entityType           String
  entityId             String
  action               String
  motivo               String?
  before               Json?
  after                Json?
  metadata             Json?
  correlationId        String?  @db.Uuid
  occurredAt           DateTime @default(now())
  creadoEn             DateTime @default(now())

  @@index([inquilinoId, entityType, entityId, occurredAt])
  @@index([inquilinoId, actorIdentityId, occurredAt])
  @@index([inquilinoId, correlationId])
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  inquilinoId    String    @db.Uuid
  aggregateType  String
  aggregateId    String
  eventType      String
  idempotencyKey String
  carga          Json
  encabezados    Json?
  occurredAt     DateTime  @default(now())
  disponibleEn   DateTime  @default(now())
  publicadoEn    DateTime?
  bloqueadoEn    DateTime?
  lockedBy       String?
  intentos       Int       @default(0)
  ultimoError    String?

  @@unique([inquilinoId, idempotencyKey])
  @@index([publicadoEn, disponibleEn, bloqueadoEn])
  @@index([inquilinoId, aggregateType, aggregateId])
}

model WebhookEndpoint {
  id                       String            @id @default(uuid()) @db.Uuid
  inquilinoId              String            @db.Uuid
  url                      String
  referenciaSecretaCifrada String
  eventosSuscritos         String[]
  estado                   EstadoRegistro    @default(ACTIVO)
  creadoEn                 DateTime          @default(now())
  actualizadoEn            DateTime          @updatedAt
  entregas                 WebhookDelivery[]

  @@index([inquilinoId, estado])
}

model WebhookDelivery {
  id               String               @id @default(uuid()) @db.Uuid
  inquilinoId      String               @db.Uuid
  endpointId       String               @db.Uuid
  eventId          String               @db.Uuid
  idempotencyKey   String
  estado           EstadoEntregaWebhook @default(PENDIENTE)
  requestBody      Json
  estadoRespuesta  Int?
  cuerpoRespuesta  String?
  intentos         Int                  @default(0)
  proximoIntentoEn DateTime?
  bloqueadoEn      DateTime?
  lockedBy         String?
  ultimoError      String?
  entregadoEn      DateTime?
  creadoEn         DateTime             @default(now())
  actualizadoEn    DateTime             @updatedAt
  endpoint         WebhookEndpoint      @relation(fields: [endpointId], references: [id], onDelete: Restrict)

  @@unique([inquilinoId, idempotencyKey])
  @@index([inquilinoId, estado, proximoIntentoEn])
}

model FileObject {
  id             String               @id @default(uuid()) @db.Uuid
  inquilinoId    String               @db.Uuid
  storageKey     String
  fileName       String
  contentType    String
  byteSize       BigInt
  checksumSha256 String
  purpose        String
  metadata       Json?
  createdById    String?              @db.Uuid
  creadoEn       DateTime             @default(now())
  productImages  ProductImage[]
  certificates   SunatCertificate[]
  documentXmls   ElectronicDocument[] @relation("DocumentoElectronicoXml")
  documentCdrs   ElectronicDocument[] @relation("DocumentoElectronicoCdr")
  documentPdfs   ElectronicDocument[] @relation("DocumentoElectronicoPdf")

  @@unique([inquilinoId, storageKey])
  @@index([inquilinoId, purpose, creadoEn])
}

model Notification {
  id            String             @id @default(uuid()) @db.Uuid
  inquilinoId   String             @db.Uuid
  recipientId   String             @db.Uuid
  channel       String
  templateKey   String
  subject       String?
  carga         Json
  estado        EstadoNotificacion @default(PENDIENTE)
  programadoEn  DateTime           @default(now())
  sentAt        DateTime?
  readAt        DateTime?
  intentos      Int                @default(0)
  ultimoError   String?
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt

  @@index([inquilinoId, recipientId, estado, creadoEn])
  @@index([inquilinoId, estado, programadoEn])
}
