model Sale {
  id                     String               @id @default(uuid()) @db.Uuid
  inquilinoId            String               @db.Uuid
  empresaId              String               @db.Uuid
  sucursalId             String               @db.Uuid
  terminalId             String?              @db.Uuid
  sesionCajaId           String?              @db.Uuid
  clienteId              String?              @db.Uuid
  cotizacionId           String?              @db.Uuid
  pedidoVentaId          String?              @db.Uuid
  cashierMembershipId    String               @db.Uuid
  number                 String
  idempotencyKey         String
  offlineId              String?
  offlineDeviceId        String?
  offlineCreatedAt       DateTime?
  sincronizadoEn         DateTime?
  estado                 EstadoVenta          @default(BORRADOR)
  moneda                 String               @db.Char(3)
  exchangeRate           Decimal              @default(1) @db.Decimal(18, 6)
  subtotal               Decimal              @default(0) @db.Decimal(18, 2)
  totalDescuento         Decimal              @default(0) @db.Decimal(18, 2)
  totalImpuesto          Decimal              @default(0) @db.Decimal(18, 2)
  total                  Decimal              @default(0) @db.Decimal(18, 2)
  totalPagado            Decimal              @default(0) @db.Decimal(18, 2)
  totalVuelto            Decimal              @default(0) @db.Decimal(18, 2)
  customerSnapshot       Json?
  billingAddressSnapshot Json?
  completadoEn           DateTime?
  voidedAt               DateTime?
  voidReason             String?
  creadoEn               DateTime             @default(now())
  actualizadoEn          DateTime             @updatedAt
  company                Company              @relation(fields: [inquilinoId, empresaId], references: [inquilinoId, id], onDelete: Restrict)
  branch                 Branch               @relation(fields: [inquilinoId, empresaId, sucursalId], references: [inquilinoId, empresaId, id], onDelete: Restrict)
  terminal               Terminal?            @relation(fields: [inquilinoId, sucursalId, terminalId], references: [inquilinoId, sucursalId, id], onDelete: Restrict)
  cashSession            CashSession?         @relation(fields: [inquilinoId, sucursalId, sesionCajaId], references: [inquilinoId, sucursalId, id], onDelete: Restrict)
  customer               Customer?            @relation(fields: [inquilinoId, clienteId], references: [inquilinoId, id], onDelete: Restrict)
  cashierMembership      Membership           @relation(fields: [inquilinoId, cashierMembershipId], references: [inquilinoId, id], onDelete: Restrict)
  quotation              Quotation?           @relation(fields: [inquilinoId, cotizacionId], references: [inquilinoId, id], onDelete: Restrict)
  salesOrder             SalesOrder?          @relation(fields: [inquilinoId, pedidoVentaId], references: [inquilinoId, id], onDelete: Restrict)
  articulos              SaleItem[]
  discounts              SaleDiscount[]
  taxes                  SaleTax[]
  pagos                  SalePayment[]
  refunds                SaleRefund[]
  referencias            SaleReference[]      @relation("ReferenciaVentaOrigen")
  referenciadBy          SaleReference[]      @relation("ReferenciaVentaDestino")
  electronicDocuments    ElectronicDocument[]
  receivable             AccountsReceivable?

  @@unique([inquilinoId, idempotencyKey])
  @@unique([inquilinoId, sucursalId, number])
  @@unique([inquilinoId, offlineDeviceId, offlineId])
  @@unique([inquilinoId, id])
  @@unique([inquilinoId, clienteId, id])
  @@index([inquilinoId, sucursalId, estado, creadoEn])
  @@index([inquilinoId, clienteId, creadoEn])
  @@index([inquilinoId, empresaId, creadoEn])
  @@index([inquilinoId, terminalId])
  @@index([inquilinoId, sesionCajaId])
  @@index([inquilinoId, cashierMembershipId])
}

