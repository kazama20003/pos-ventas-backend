generator client {
  provider     = "prisma-client"
  output       = "../../generado/operaciones"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Prisma schema cannot express PostgreSQL CHECK constraints or row-level security.
/// Add those controls in SQL migrations and keep tenant context enforced in application transactions.

enum TipoAlmacen {
  PRINCIPAL
  TRANSITO
  MERMA
  DEVOLUCIONES
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO
  SUSPENDIDO
  ARCHIVADO
  ELIMINADO
}

enum EstadoMembresia {
  INVITADA
  PENDIENTE_APROBACION
  ACTIVA
  SUSPENDIDA
  REVOCADA
  VENCIDA
}

enum EfectoPolitica {
  PERMITIR
  DENEGAR
}

enum TipoProducto {
  ESTANDAR
  SERVICIO
  PAQUETE
}

enum TipoCodigoBarras {
  EAN13
  EAN8
  UPC_A
  CODIGO128
  QR
  PLU
  INTERNO
}

enum AfectacionImpuesto {
  GRAVADO
  EXONERADO
  INAFECTO
  GRATUITO
  EXPORTACION
}

enum TipoMovimientoInventario {
  APERTURA
  RECEPCION_COMPRA
  DEVOLUCION_COMPRA
  VENTA
  DEVOLUCION_VENTA
  AJUSTE_ENTRADA
  AJUSTE_SALIDA
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  GANANCIA_CONTEO
  PERDIDA_CONTEO
  PRODUCCION_ENTRADA
  PRODUCCION_SALIDA
}

enum EstadoReservaInventario {
  ACTIVA
  PARCIALMENTE_ATENDIDA
  ATENDIDA
  LIBERADA
  VENCIDA
  CANCELADA
}

enum EstadoTransferenciaInventario {
  BORRADOR
  SOLICITADA
  APROBADA
  EN_TRANSITO
  RECIBIDA_PARCIALMENTE
  RECIBIDA
  CANCELADA
  RECHAZADA
}

enum EstadoConteoInventario {
  BORRADOR
  EN_PROGRESO
  ENVIADO
  APROBADO
  CONTABILIZADO
  CANCELADO
}

enum EstadoSerieInventario {
  DISPONIBLE
  RESERVADA
  VENDIDA
  EN_TRANSITO
  DEVUELTA
  DANADA
  DESCARTADA
}

enum TipoCliente {
  PERSONA
  EMPRESA
}

enum TipoDocumentoIdentidad {
  DNI
  RUC
  CE
  PASAPORTE
  ID_TRIBUTARIO_EXTRANJERO
  OTRO
}

enum EstadoCuentaCredito {
  ACTIVA
  SUSPENDIDA
  CERRADA
  BLOQUEADA
}

enum EstadoDocumentoComercial {
  BORRADOR
  CONFIRMADO
  PARCIALMENTE_ATENDIDO
  ATENDIDO
  VENCIDO
  CANCELADO
  RECHAZADO
}

enum EstadoVenta {
  BORRADOR
  PENDIENTE_PAGO
  PAGADA_PARCIALMENTE
  PAGADA
  COMPLETADA
  ANULADA
  DEVUELTA_PARCIALMENTE
  DEVUELTA
  VENCIDA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA_BANCARIA
  BILLETERA_DIGITAL
  CREDITO_TIENDA
  CREDITO
  OTRO
}

enum EstadoIntentoPago {
  CREADO
  REQUIERE_ACCION
  PROCESANDO
  EXITOSO
  DEVUELTO_PARCIALMENTE
  DEVUELTO
  CANCELADO
  FALLIDO
  EXPIRADO
}

enum EstadoTransaccionPago {
  PENDIENTE
  AUTORIZADA
  CAPTURADA
  LIQUIDADA
  ANULADA
  FALLIDA
  REVERSADA
}

enum EstadoDevolucionPago {
  PENDIENTE
  PROCESANDO
  EXITOSA
  FALLIDA
  CANCELADA
}

enum EstadoLiquidacion {
  PENDIENTE
  EN_TRANSITO
  PAGADA
  FALLIDA
  CANCELADA
}

enum EstadoDevolucionVenta {
  BORRADOR
  PENDIENTE
  APROBADA
  COMPLETADA
  RECHAZADA
  CANCELADA
}

enum EstadoSesionCaja {
  ABIERTA
  CERRANDO
  CERRADA
  CONCILIADA
  CANCELADA
}

enum TipoMovimientoCaja {
  FONDO_APERTURA
  VENTA_EFECTIVO
  DEVOLUCION_EFECTIVO
  INGRESO_EFECTIVO
  EGRESO_EFECTIVO
  RETIRO
  AJUSTE_CIERRE
}

enum TipoDocumentoElectronico {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
}

enum TerminosPagoFiscal {
  CONTADO
  CREDITO
}

enum EstadoDocumentoElectronico {
  BORRADOR
  EN_COLA
  FIRMADO
  ENVIADO
  ACEPTADO
  ACEPTADO_CON_OBSERVACIONES
  RECHAZADO
  BAJA_SOLICITADA
  ANULADO
  ERROR
}

enum EstadoOrdenCompra {
  BORRADOR
  APROBADA
  RECIBIDA_PARCIALMENTE
  RECIBIDA
  CERRADA
  CANCELADA
}

enum EstadoRecepcionCompra {
  BORRADOR
  CONTABILIZADA
  CANCELADA
}

enum EstadoCuentaPorCobrarPagar {
  PENDIENTE
  PAGADA_PARCIALMENTE
  PAGADA
  VENCIDA
  CANCELADA
  CASTIGADA
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  LEIDA
  FALLIDA
  CANCELADA
}

enum EstadoEntregaWebhook {
  PENDIENTE
  ENTREGANDO
  EXITOSA
  FALLIDA
  AGOTADA
  CANCELADA
}

model Tenant {
  id                   String         @id @default(uuid()) @db.Uuid
  codigo               String         @unique
  nombre               String
  estado               EstadoRegistro @default(ACTIVO)
  idiomaPredeterminado String         @default("es-PE")
  creadoEn             DateTime       @default(now())
  actualizadoEn        DateTime       @updatedAt
  organizaciones       Organization[]
  identidades          UserIdentity[]
  roles                Role[]
}

model Organization {
  id            String         @id @default(uuid()) @db.Uuid
  inquilinoId   String         @db.Uuid
  codigo        String
  nombre        String
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [inquilinoId], references: [id], onDelete: Restrict)
  empresas      Company[]
  memberships   Membership[]

  @@unique([inquilinoId, codigo])
  @@unique([inquilinoId, id])
  @@index([inquilinoId, estado])
}

model Company {
  id                String                   @id @default(uuid()) @db.Uuid
  inquilinoId       String                   @db.Uuid
  organizacionId    String                   @db.Uuid
  razonSocial       String
  nombreComercial   String?
  ruc               String                   @db.VarChar(11)
  sunatUbigeo       String?                  @db.VarChar(6)
  fiscalAddress     String?
  moneda            String                   @default("PEN") @db.Char(3)
  timezone          String                   @default("America/Lima")
  estado            EstadoRegistro           @default(ACTIVO)
  creadoEn          DateTime                 @default(now())
  actualizadoEn     DateTime                 @updatedAt
  organization      Organization             @relation(fields: [inquilinoId, organizacionId], references: [inquilinoId, id], onDelete: Restrict)
  sucursales        Branch[]
  seriesDocumento   DocumentSeries[]
  certificadosSunat SunatCertificate[]
  cuentasProveedor  PaymentProviderAccount[]
  ventas            Sale[]

  @@unique([inquilinoId, ruc])
  @@unique([inquilinoId, id])
  @@index([inquilinoId, organizacionId, estado])
}

model Branch {
  id            String          @id @default(uuid()) @db.Uuid
  inquilinoId   String          @db.Uuid
  empresaId     String          @db.Uuid
  codigo        String
  nombre        String
  sunatUbigeo   String?         @db.VarChar(6)
  address       String?
  phone         String?
  timezone      String          @default("America/Lima")
  estado        EstadoRegistro  @default(ACTIVO)
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt
  company       Company         @relation(fields: [inquilinoId, empresaId], references: [inquilinoId, id], onDelete: Restrict)
  almacenes     Warehouse[]
  cajas         CashRegister[]
  terminales    Terminal[]
  ventas        Sale[]
  quotations    Quotation[]
  pedidosVenta  SalesOrder[]
  pedidosCompra PurchaseOrder[]
  sesionesCaja  CashSession[]

  @@unique([inquilinoId, empresaId, codigo])
  @@unique([inquilinoId, id])
  @@unique([inquilinoId, empresaId, id])
  @@index([inquilinoId, empresaId, estado])
}

model Warehouse {
  id                    String                 @id @default(uuid()) @db.Uuid
  inquilinoId           String                 @db.Uuid
  sucursalId            String                 @db.Uuid
  codigo                String
  nombre                String
  address               String?
  tipo                  TipoAlmacen            @default(PRINCIPAL)
  esPredeterminado      Boolean                @default(false)
  estado                EstadoRegistro         @default(ACTIVO)
  creadoEn              DateTime               @default(now())
  actualizadoEn         DateTime               @updatedAt
  branch                Branch                 @relation(fields: [inquilinoId, sucursalId], references: [inquilinoId, id], onDelete: Restrict)
  saldosInventario      StockBalance[]
  asientosInventario    InventoryLedgerEntry[]
  reservations          InventoryReservation[]
  transferenciasSalida  InventoryTransfer[]    @relation("OrigenTransferencia")
  transferenciasEntrada InventoryTransfer[]    @relation("DestinoTransferencia")
  conteosInventario     InventoryCount[]
  lots                  InventoryLot[]
  serials               InventorySerial[]
  receipts              PurchaseReceipt[]

  @@unique([inquilinoId, sucursalId, codigo])
  @@unique([inquilinoId, id])
  @@index([inquilinoId, sucursalId, estado])
}

model CashRegister {
  id            String         @id @default(uuid()) @db.Uuid
  inquilinoId   String         @db.Uuid
  sucursalId    String         @db.Uuid
  codigo        String
  nombre        String
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  branch        Branch         @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  terminales    Terminal[]
  sessions      CashSession[]

  @@unique([inquilinoId, sucursalId, codigo])
  @@index([inquilinoId, sucursalId, estado])
}

model Terminal {
  id               String         @id @default(uuid()) @db.Uuid
  inquilinoId      String         @db.Uuid
  sucursalId       String         @db.Uuid
  cajaId           String?        @db.Uuid
  codigo           String
  nombre           String
  claveDispositivo String?
  estado           EstadoRegistro @default(ACTIVO)
  ultimoVistoEn    DateTime?
  creadoEn         DateTime       @default(now())
  actualizadoEn    DateTime       @updatedAt
  branch           Branch         @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  cashRegister     CashRegister?  @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  sessions         CashSession[]
  ventas           Sale[]

  @@unique([inquilinoId, sucursalId, codigo])
  @@unique([inquilinoId, claveDispositivo])
  @@unique([inquilinoId, sucursalId, id])
  @@index([inquilinoId, sucursalId, estado])
}

model UserIdentity {
  id              String         @id @default(uuid()) @db.Uuid
  inquilinoId     String         @db.Uuid
  /// Federated identity subject. Placeholder "invitacion:<email>" until the
  /// user first signs in with Google, then bound to "google:<sub>".
  sujetoExterno   String
  email           String
  nombreVisible   String
  estado          EstadoRegistro @default(ACTIVO)
  ultimoIngresoEn DateTime?
  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [inquilinoId], references: [id], onDelete: Restrict)
  memberships     Membership[]

  @@unique([inquilinoId, sujetoExterno])
  @@unique([inquilinoId, email])
  @@unique([inquilinoId, id])
  @@index([inquilinoId, estado])
}

model Membership {
  id                 String            @id @default(uuid()) @db.Uuid
  inquilinoId        String            @db.Uuid
  organizacionId     String            @db.Uuid
  identidadUsuarioId String            @db.Uuid
  estado             EstadoMembresia   @default(INVITADA)
  vigenteDesde       DateTime          @default(now())
  vigenteHasta       DateTime?
  creadoEn           DateTime          @default(now())
  actualizadoEn      DateTime          @updatedAt
  organization       Organization      @relation(fields: [inquilinoId, organizacionId], references: [inquilinoId, id], onDelete: Restrict)
  userIdentity       UserIdentity      @relation(fields: [inquilinoId, identidadUsuarioId], references: [inquilinoId, id], onDelete: Restrict)
  roles              MembershipRole[]
  policies           AccessPolicy[]
  limits             MembershipLimit[]
  cashierSales       Sale[]

  @@unique([inquilinoId, organizacionId, identidadUsuarioId])
  @@unique([inquilinoId, id])
  @@index([inquilinoId, identidadUsuarioId, estado])
}

model Role {
  id            String           @id @default(uuid()) @db.Uuid
  inquilinoId   String           @db.Uuid
  codigo        String
  nombre        String
  descripcion   String?
  isSystem      Boolean          @default(false)
  estado        EstadoRegistro   @default(ACTIVO)
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [inquilinoId], references: [id], onDelete: Restrict)
  permissions   RolePermission[]
  memberships   MembershipRole[]

  @@unique([inquilinoId, codigo])
  @@index([inquilinoId, estado])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  clave       String           @unique
  resource    String
  action      String
  descripcion String?
  creadoEn    DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  inquilinoId String         @db.Uuid
  rolId       String         @db.Uuid
  permisoId   String         @db.Uuid
  effect      EfectoPolitica @default(PERMITIR)
  constraints Json?
  role        Role           @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permission  Permission     @relation(fields: [permisoId], references: [id], onDelete: Restrict)

  @@id([rolId, permisoId])
  @@index([inquilinoId, permisoId])
}

model MembershipRole {
  inquilinoId  String     @db.Uuid
  membresiaId  String     @db.Uuid
  rolId        String     @db.Uuid
  sucursalId   String?    @db.Uuid
  vigenteHasta DateTime?
  membership   Membership @relation(fields: [membresiaId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [rolId], references: [id], onDelete: Restrict)

  @@id([membresiaId, rolId])
  @@index([inquilinoId, sucursalId])
}

model AccessPolicy {
  id            String         @id @default(uuid()) @db.Uuid
  inquilinoId   String         @db.Uuid
  membresiaId   String         @db.Uuid
  permissionKey String
  effect        EfectoPolitica
  sucursalId    String?        @db.Uuid
  resourceId    String?
  conditions    Json?
  creadoEn      DateTime       @default(now())
  membership    Membership     @relation(fields: [membresiaId], references: [id], onDelete: Cascade)

  @@index([inquilinoId, membresiaId, permissionKey])
}

model MembershipLimit {
  id           String     @id @default(uuid()) @db.Uuid
  inquilinoId  String     @db.Uuid
  membresiaId  String     @db.Uuid
  clave        String
  decimalValue Decimal?   @db.Decimal(18, 4)
  integerValue Int?
  moneda       String?    @db.Char(3)
  vigenteHasta DateTime?
  membership   Membership @relation(fields: [membresiaId], references: [id], onDelete: Cascade)

  @@unique([inquilinoId, membresiaId, clave])
}

model Category {
  id            String            @id @default(uuid()) @db.Uuid
  inquilinoId   String            @db.Uuid
  padreId       String?           @db.Uuid
  codigo        String
  nombre        String
  descripcion   String?
  estado        EstadoRegistro    @default(ACTIVO)
  sortOrder     Int               @default(0)
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt
  parent        Category?         @relation("ArbolCategoria", fields: [padreId], references: [id], onDelete: Restrict)
  children      Category[]        @relation("ArbolCategoria")
  products      ProductCategory[]

  @@unique([inquilinoId, codigo])
  @@index([inquilinoId, padreId, estado])
}

model Brand {
  id            String         @id @default(uuid()) @db.Uuid
  inquilinoId   String         @db.Uuid
  codigo        String
  nombre        String
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  products      Product[]

  @@unique([inquilinoId, codigo])
  @@index([inquilinoId, estado])
}

model UnitOfMeasure {
  id            String           @id @default(uuid()) @db.Uuid
  inquilinoId   String           @db.Uuid
  codigo        String
  sunatCode     String           @db.VarChar(3)
  nombre        String
  symbol        String
  decimals      Int              @default(3)
  estado        EstadoRegistro   @default(ACTIVO)
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt
  variants      ProductVariant[]

  @@unique([inquilinoId, codigo])
  @@index([inquilinoId, sunatCode, estado])
}

model Tax {
  id               String              @id @default(uuid()) @db.Uuid
  inquilinoId      String              @db.Uuid
  codigo           String
  nombre           String
  sunatTributeCode String?
  affectation      AfectacionImpuesto
  rate             Decimal             @db.Decimal(7, 4)
  includedInPrice  Boolean             @default(true)
  vigenteDesde     DateTime?
  vigenteHasta     DateTime?
  estado           EstadoRegistro      @default(ACTIVO)
  creadoEn         DateTime            @default(now())
  actualizadoEn    DateTime            @updatedAt
  variantTaxes     ProductVariantTax[]

  @@unique([inquilinoId, codigo])
  @@index([inquilinoId, estado, vigenteDesde])
}

model Product {
  id            String              @id @default(uuid()) @db.Uuid
  inquilinoId   String              @db.Uuid
  marcaId       String?             @db.Uuid
  codigo        String
  nombre        String
  descripcion   String?
  imagenUrl     String?
  kind          TipoProducto        @default(ESTANDAR)
  estado        EstadoRegistro      @default(ACTIVO)
  creadoEn      DateTime            @default(now())
  actualizadoEn DateTime            @updatedAt
  brand         Brand?              @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  categories    ProductCategory[]
  variants      ProductVariant[]
  images        ProductImage[]
  bundleItems   ProductBundleItem[] @relation("ProductoPaquete")

  @@unique([inquilinoId, codigo])
  @@index([inquilinoId, nombre, estado])
}

model ProductCategory {
  inquilinoId String   @db.Uuid
  productoId  String   @db.Uuid
  categoriaId String   @db.Uuid
  isPrimary   Boolean  @default(false)
  product     Product  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@id([productoId, categoriaId])
  @@index([inquilinoId, categoriaId])
}

model ProductVariant {
  id                 String                  @id @default(uuid()) @db.Uuid
  inquilinoId        String                  @db.Uuid
  productoId         String                  @db.Uuid
  unidadMedidaId     String                  @db.Uuid
  sku                String
  nombre             String
  attributes         Json?
  cost               Decimal                 @default(0) @db.Decimal(18, 6)
  weight             Decimal?                @db.Decimal(18, 6)
  isStockTracked     Boolean                 @default(true)
  tracksLots         Boolean                 @default(false)
  tracksSerials      Boolean                 @default(false)
  isWeighted         Boolean                 @default(false)
  isService          Boolean                 @default(false)
  allowNegativeStock Boolean                 @default(false)
  estado             EstadoRegistro          @default(ACTIVO)
  creadoEn           DateTime                @default(now())
  actualizadoEn      DateTime                @updatedAt
  product            Product                 @relation(fields: [productoId], references: [id], onDelete: Restrict)
  unitOfMeasure      UnitOfMeasure           @relation(fields: [unidadMedidaId], references: [id], onDelete: Restrict)
  barcodigos         ProductBarcodigo[]
  prices             PriceListItem[]
  taxes              ProductVariantTax[]
  bundleComponents   ProductBundleItem[]     @relation("ComponentePaquete")
  saldosInventario   StockBalance[]
  asientosInventario InventoryLedgerEntry[]
  lots               InventoryLot[]
  serials            InventorySerial[]
  reservations       InventoryReservation[]
  transferItems      InventoryTransferItem[]
  countItems         InventoryCountItem[]
  quotationItems     QuotationItem[]
  salesOrderItems    SalesOrderItem[]
  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  receiptItems       PurchaseReceiptItem[]

  @@unique([inquilinoId, sku])
  @@unique([inquilinoId, id])
  @@index([inquilinoId, productoId, estado])
}

model ProductBarcodigo {
  id          String           @id @default(uuid()) @db.Uuid
  inquilinoId String           @db.Uuid
  varianteId  String           @db.Uuid
  codigo      String
  tipo        TipoCodigoBarras
  isPrimary   Boolean          @default(false)
  creadoEn    DateTime         @default(now())
  variant     ProductVariant   @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  @@unique([inquilinoId, codigo])
  @@index([inquilinoId, varianteId])
}

model ProductImage {
  id          String     @id @default(uuid()) @db.Uuid
  inquilinoId String     @db.Uuid
  productoId  String     @db.Uuid
  fileId      String     @db.Uuid
  altText     String?
  sortOrder   Int        @default(0)
  creadoEn    DateTime   @default(now())
  product     Product    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  file        FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([inquilinoId, productoId, fileId])
}

model ProductVariantTax {
  inquilinoId String         @db.Uuid
  varianteId  String         @db.Uuid
  taxId       String         @db.Uuid
  isPrimary   Boolean        @default(false)
  variant     ProductVariant @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  tax         Tax            @relation(fields: [taxId], references: [id], onDelete: Restrict)

  @@id([varianteId, taxId])
  @@index([inquilinoId, taxId])
}

model ProductBundleItem {
  id                 String         @id @default(uuid()) @db.Uuid
  inquilinoId        String         @db.Uuid
  bundleProductId    String         @db.Uuid
  componentVariantId String         @db.Uuid
  cantidad           Decimal        @db.Decimal(18, 6)
  bundleProduct      Product        @relation("ProductoPaquete", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentVariant   ProductVariant @relation("ComponentePaquete", fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@unique([inquilinoId, bundleProductId, componentVariantId])
}

model PriceList {
  id            String          @id @default(uuid()) @db.Uuid
  inquilinoId   String          @db.Uuid
  empresaId     String          @db.Uuid
  codigo        String
  nombre        String
  moneda        String          @db.Char(3)
  isDefault     Boolean         @default(false)
  iniciaEn      DateTime?
  terminaEn     DateTime?
  estado        EstadoRegistro  @default(ACTIVO)
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt
  articulos     PriceListItem[]

  @@unique([inquilinoId, empresaId, codigo])
  @@index([inquilinoId, empresaId, estado, iniciaEn])
}

model PriceListItem {
  id             String         @id @default(uuid()) @db.Uuid
  inquilinoId    String         @db.Uuid
  listaPreciosId String         @db.Uuid
  varianteId     String         @db.Uuid
  minQuantity    Decimal        @default(1) @db.Decimal(18, 6)
  monto          Decimal        @db.Decimal(18, 6)
  iniciaEn       DateTime?
  terminaEn      DateTime?
