model StockBalance {
  id            String         @id @default(uuid()) @db.Uuid
  inquilinoId   String         @db.Uuid
  almacenId     String         @db.Uuid
  varianteId    String         @db.Uuid
  /// Transactional projection only; InventoryLedgerEntry is authoritative.
  enStock       Decimal        @default(0) @db.Decimal(18, 6)
  reserved      Decimal        @default(0) @db.Decimal(18, 6)
  enTransito    Decimal        @default(0) @db.Decimal(18, 6)
  available     Decimal        @default(0) @db.Decimal(18, 6)
  costoPromedio Decimal        @default(0) @db.Decimal(18, 6)
  /// Punto de reorden: alerta cuando available <= stockMinimo (0 = sin alerta).
  stockMinimo   Decimal        @default(0) @db.Decimal(18, 6)
  /// Nivel objetivo de reposición (0 = sin tope; sugerido = stockMaximo - available).
  stockMaximo   Decimal        @default(0) @db.Decimal(18, 6)
  version       Int            @default(0)
  actualizadoEn DateTime       @updatedAt
  warehouse     Warehouse      @relation(fields: [almacenId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@unique([inquilinoId, almacenId, varianteId])
  @@index([inquilinoId, almacenId, varianteId])
}

model InventoryLedgerEntry {
  /// Immutable inventory posting ledger. Application transactions maintain StockBalance projections.
  id             String                   @id @default(uuid()) @db.Uuid
  inquilinoId    String                   @db.Uuid
  almacenId      String                   @db.Uuid
  varianteId     String                   @db.Uuid
  loteId         String?                  @db.Uuid
  serieId        String?                  @db.Uuid
  movementType   TipoMovimientoInventario
  cantidad       Decimal                  @db.Decimal(18, 6)
  costoUnitario  Decimal?                 @db.Decimal(18, 6)
  totalCost      Decimal?                 @db.Decimal(18, 6)
  referenciaType String
  referenciaId   String                   @db.Uuid
  correlationId  String?                  @db.Uuid
  idempotencyKey String
  notas          String?
  occurredAt     DateTime
  creadoEn       DateTime                 @default(now())
  warehouse      Warehouse                @relation(fields: [inquilinoId, almacenId], references: [inquilinoId, id], onDelete: Restrict)
  variant        ProductVariant           @relation(fields: [inquilinoId, varianteId], references: [inquilinoId, id], onDelete: Restrict)
  lot            InventoryLot?            @relation(fields: [inquilinoId, loteId], references: [inquilinoId, id], onDelete: Restrict)
  serial         InventorySerial?         @relation(fields: [inquilinoId, serieId], references: [inquilinoId, id], onDelete: Restrict)

  @@unique([inquilinoId, idempotencyKey])
  @@index([inquilinoId, almacenId, varianteId, occurredAt])
  @@index([inquilinoId, referenciaType, referenciaId])
  @@index([inquilinoId, correlationId])
  @@index([inquilinoId, loteId])
  @@index([inquilinoId, serieId])
}

