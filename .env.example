# Select environment before running application or Prisma commands.
ENV=local
NODE_ENV=development
PORT=5000

# Logical database boundaries. Never commit production credentials.
# Row Level Security (tenant isolation) only takes effect when the RUNTIME
# connection uses a NON-superuser role. Migrations run as the owner/superuser.
# To activate RLS: grant login to the roles created by the RLS migrations and
# point each runtime URL at its corresponding non-superuser role, e.g.:
#   ALTER ROLE pos_app WITH LOGIN PASSWORD '<strong-secret>';
#   ALTER ROLE pos_management_app WITH LOGIN PASSWORD '<strong-secret>';
#   CORE_DATABASE_URL="postgresql://pos_app:<secret>@host:5432/core-pos?schema=public"
#   MANAGEMENT_DATABASE_URL="postgresql://pos_management_app:<secret>@host:5432/management-pos?schema=public"
CORE_DATABASE_URL="postgresql://pos_app:CoreLocal2026Segura@localhost:5432/core-pos?schema=public"
MANAGEMENT_DATABASE_URL="postgresql://pos_management_app:ManagementLocal2026Segura@localhost:5432/management-pos?schema=public"
# Dedicated worker role with BYPASSRLS, restricted to OutboxEvent in Core. It
# claims events across tenants; never use it for HTTP request handling.
CORE_OUTBOX_DATABASE_URL=""
TENANT_OUTBOX_RELAY_ENABLED="true"
TENANT_OUTBOX_RELAY_INTERVAL_MS=5000

# Optional shadow databases, only needed for `prisma migrate diff --from-migrations`.
# CORE_SHADOW_DATABASE_URL="postgresql://postgres:<password>@localhost:5432/core-pos-shadow?schema=public"
# MANAGEMENT_SHADOW_DATABASE_URL="postgresql://postgres:<password>@localhost:5432/management-pos-shadow?schema=public"

# Max connections per pool, per process instance. Size with PgBouncer in production.
DATABASE_POOL_MAX=10

# Use a unique, high-entropy secret with at least 32 characters.
JWT_SECRET="replace-with-a-secure-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="15m"

# Google OAuth client id. The backend verifies the ID token the client obtains
# after Google sign-in against this audience. Login is passwordless + Google-only.
GOOGLE_CLIENT_ID="your-app.apps.googleusercontent.com"
# Orígenes separados por coma. En producción no se permite "*" porque la API
# usa credenciales; indica los dominios reales del frontend.
CORS_ORIGIN="http://localhost:3001"
LOG_LEVEL="debug"

# --- Google Cloud Storage (imágenes de producto) ---
# Si estas variables faltan, la app arranca igual; los endpoints /archivos
# responden 503 "no configurado" hasta que se llenen. NO subir claves reales.
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
ALMACEN_GCS_BUCKET="your-product-images-bucket"
# URL pública del bucket o de su CDN, sin barra final.
ALMACEN_GCS_PUBLIC_URL="https://storage.googleapis.com/your-product-images-bucket"
# En Cloud Run, no definir esta variable: asignar una cuenta de servicio con
# roles/storage.objectCreator en el bucket y permiso iam.serviceAccounts.signBlob
# para generar URLs firmadas. En desarrollo local, indicar la ruta absoluta al
# JSON de una cuenta de servicio que no se debe versionar.
# GOOGLE_APPLICATION_CREDENTIALS="C:/secure/google-service-account.json"

# Correo (Resend). Sin RESEND_API_KEY los correos se omiten.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
APP_URL=http://localhost:3001
