# Select environment before running application or Prisma commands.
ENV=local
NODE_ENV=development
PORT=5000

# Logical database boundaries. Never commit production credentials.
# Row Level Security (tenant isolation) only takes effect when the RUNTIME
# connection uses a NON-superuser role. Migrations run as the owner/superuser.
# To activate RLS: grant login to the "pos_app" role created by the RLS
# migration and point CORE_DATABASE_URL at it, e.g.:
#   ALTER ROLE pos_app WITH LOGIN PASSWORD '<strong-secret>';
#   CORE_DATABASE_URL="postgresql://pos_app:<secret>@host:5432/core-pos?schema=public"
CORE_DATABASE_URL="postgresql://postgres:<password>@localhost:5432/core-pos?schema=public"
MANAGEMENT_DATABASE_URL="postgresql://postgres:<password>@localhost:5432/management-pos?schema=public"

# Optional shadow databases, only needed for `prisma migrate diff --from-migrations`.
# CORE_SHADOW_DATABASE_URL="postgresql://postgres:<password>@localhost:5432/core-pos-shadow?schema=public"
# MANAGEMENT_SHADOW_DATABASE_URL="postgresql://postgres:<password>@localhost:5432/management-pos-shadow?schema=public"

# Max connections per pool, per process instance. Size with PgBouncer in production.
DATABASE_POOL_MAX=10

# Use a unique, high-entropy secret with at least 32 characters.
JWT_SECRET="replace-with-a-secure-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="15m"

# Google OAuth client id. The backend verifies the ID token the client obtains
# after Google sign-in against this audience. Login is passwordless + Google-only.
GOOGLE_CLIENT_ID="your-app.apps.googleusercontent.com"
CORS_ORIGIN="http://localhost:3001"
LOG_LEVEL="debug"
