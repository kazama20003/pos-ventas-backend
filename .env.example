# Select environment before running application or Prisma commands.
ENV=local
NODE_ENV=development
PORT=3000

# Logical database boundaries. Never commit production credentials.
CORE_DATABASE_URL="postgresql://postgres:Brayan123@localhost:5432/core-pos?schema=public"
MANAGEMENT_DATABASE_URL="postgresql://postgres:Brayan123@localhost:5432/management-pos?schema=public"

# Use a unique, high-entropy secret with at least 32 characters.
JWT_SECRET="replace-with-a-secure-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="15m"
CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL="debug"
